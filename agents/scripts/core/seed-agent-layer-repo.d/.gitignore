# the-unwilling-agentic-bunch — local-only artefacts the framework writes into the
# tree it runs in. In a consuming project the layer is a submodule and these land in
# the HOST tree (whose own .gitignore covers them); this file covers the layer repo
# when it runs on itself — CI, and contributors working on the layer directly.

# Harness adapters, regenerated by `bash agents/scripts/core/setup-harness.sh <name>`.
/.claude/
/.codex/
/.cursor/
/.pi/
/.agents/

# Per-session orchestrator state (session scratchpad, redacted prompt-intent capture,
# coderabbit-triage dumps, progress log).
/.session-context.md
/.session-context.archive/
/.session-intent/
/.triage-reviews.json
/.triage-review-comments.json
/.triage-issue-comments.json
/.progress.log

# Python bytecode from the gate scripts.
__pycache__/
*.pyc

# Scratch output from gates that build into the tree.
/build/
