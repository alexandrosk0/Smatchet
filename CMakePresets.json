{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 24,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "_smatchet-msvc-base",
            "hidden": true,
            "description": "Shared MSVC defaults. Run from a VS Developer Command Prompt or with vcvarsall.bat sourced.",
            "generator": "Ninja",
            "cacheVariables": {
                "SMATCHET_WITH_LUA_AUTOMATION": "ON",
                "SMATCHET_WITH_MCP": "ON",
                "CMAKE_C_COMPILER": "cl.exe",
                "CMAKE_CXX_COMPILER": "cl.exe",
                "CMAKE_LINKER": "link.exe"
            }
        },
        {
            "name": "_smatchet-clang-base",
            "hidden": true,
            "description": "Shared Clang/LLVM defaults. Uses clang-cl on Windows for MSVC ABI compatibility. Install via: winget install LLVM.LLVM (Windows), apt install clang lld (Linux), or Xcode Command Line Tools (macOS).",
            "generator": "Ninja",
            "cacheVariables": {
                "SMATCHET_WITH_LUA_AUTOMATION": "ON",
                "SMATCHET_WITH_MCP": "ON",
                "CMAKE_C_COMPILER": "clang-cl",
                "CMAKE_CXX_COMPILER": "clang-cl"
            }
        },
        {
            "name": "_smatchet-light-features",
            "hidden": true,
            "description": "Light profile: Lua + command registry ON; MCP, AI assistant, and Whisper OFF.",
            "cacheVariables": {
                "SMATCHET_WITH_LUA_AUTOMATION": "ON",
                "SMATCHET_WITH_MCP": "OFF",
                "SMATCHET_WITH_AI": "OFF",
                "SMATCHET_WITH_WHISPER": "OFF",
                "SMATCHET_WHISPER_LOCAL_BACKEND": "OFF"
            }
        },
        {
            "name": "vs-unreal-msvc",
            "hidden": true,
            "inherits": [
                "_smatchet-light-features"
            ],
            "description": "Hidden MSVC preset for Win64 Unreal plugin packaging consumed by Unreal Build Tool.",
            "generator": "Visual Studio 17 2022",
            "binaryDir": "${sourceDir}/build/vs-unreal-msvc",
            "architecture": "x64",
            "cacheVariables": {
                "SMATCHET_UNREAL_THIRDPARTY_DIR": "${sourceDir}/UnrealPlugins/SmatchetImGuiPlugin/ThirdParty/Smatchet"
            }
        },
        {
            "name": "ninja-iter-msvc",
            "inherits": [
                "_smatchet-msvc-base"
            ],
            "displayName": "Ninja Iteration (MSVC)",
            "description": "Fast standalone developer build with MSVC. RelWithDebInfo, compile_commands on. Run from a VS Developer Command Prompt.",
            "binaryDir": "${sourceDir}/build/ninja-iter-msvc",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "ninja-debug-msvc",
            "inherits": [
                "_smatchet-msvc-base"
            ],
            "displayName": "Ninja Debug (MSVC)",
            "description": "Full standalone debug build with MSVC. Builds SmatchetTests alongside SmatchetStandalone.",
            "binaryDir": "${sourceDir}/build/ninja-debug-msvc",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "SMATCHET_BUILD_TESTS": "ON",
                "SMATCHET_AGENT_DEBUG": "ON"
            }
        },
        {
            "name": "ninja-test-msvc",
            "inherits": [
                "_smatchet-msvc-base"
            ],
            "displayName": "Ninja Tests (MSVC)",
            "description": "Dedicated doctest rig preset for MSVC. RelWithDebInfo for fast configure + run.",
            "binaryDir": "${sourceDir}/build/ninja-test-msvc",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "SMATCHET_BUILD_TESTS": "ON",
                "SMATCHET_BUILD_LUA_TESTS": "ON"
            }
        },
        {
            "name": "ninja-ui-test-msvc",
            "inherits": [
                "_smatchet-msvc-base"
            ],
            "displayName": "Ninja UI Tests (MSVC)",
            "description": "ImGui Test Engine bucket-E surface. RelWithDebInfo, SMATCHET_BUILD_UI_TESTS=ON.",
            "binaryDir": "${sourceDir}/build/ninja-ui-test-msvc",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "SMATCHET_BUILD_UI_TESTS": "ON",
                "SMATCHET_DEBUG_VISIBLE_CUE_HARNESS": "ON",
                "SMATCHET_AGENT_DEBUG": "ON"
            }
        },
        {
            "name": "ninja-msvc-asan",
            "inherits": [
                "_smatchet-msvc-base"
            ],
            "displayName": "Ninja Debug + MSVC AddressSanitizer (CI)",
            "description": "ASAN via MSVC /fsanitize=address. Run from a VS Developer Command Prompt.",
            "binaryDir": "${sourceDir}/build/ninja-msvc-asan",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "SMATCHET_SANITIZER": "asan",
                "SMATCHET_AGENT_DEBUG": "ON"
            }
        },
        {
            "name": "ninja-iter-clang",
            "inherits": [
                "_smatchet-clang-base"
            ],
            "displayName": "Ninja Iteration (Clang)",
            "description": "Fast standalone developer build with Clang/LLVM. Uses clang-cl on Windows for MSVC ABI compat. Install: winget install LLVM.LLVM",
            "binaryDir": "${sourceDir}/build/ninja-iter-clang",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "ninja-debug-clang",
            "inherits": [
                "_smatchet-clang-base"
            ],
            "displayName": "Ninja Debug (Clang)",
            "description": "Full standalone debug build with Clang/LLVM. Builds SmatchetTests alongside SmatchetStandalone.",
            "binaryDir": "${sourceDir}/build/ninja-debug-clang",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "SMATCHET_BUILD_TESTS": "ON",
                "SMATCHET_AGENT_DEBUG": "ON"
            }
        },
        {
            "name": "ninja-test-clang",
            "inherits": [
                "_smatchet-clang-base"
            ],
            "displayName": "Ninja Tests (Clang)",
            "description": "Dedicated doctest rig preset for Clang. RelWithDebInfo for fast configure + run.",
            "binaryDir": "${sourceDir}/build/ninja-test-clang",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "SMATCHET_BUILD_TESTS": "ON",
                "SMATCHET_BUILD_LUA_TESTS": "ON"
            }
        },
        {
            "name": "ninja-clang-asan",
            "inherits": [
                "_smatchet-clang-base"
            ],
            "displayName": "Ninja Debug + Clang AddressSanitizer + UBSan",
            "description": "ASAN + UBSan via Clang. Full sanitizer suite including UBSan (which MSVC lacks).",
            "binaryDir": "${sourceDir}/build/ninja-clang-asan",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "SMATCHET_SANITIZER": "asan",
                "SMATCHET_AGENT_DEBUG": "ON"
            }
        },
        {
            "name": "ninja-iter-unreal-msvc",
            "inherits": [
                "_smatchet-msvc-base"
            ],
            "displayName": "Ninja Unreal Iteration (MSVC)",
            "description": "Fast Unreal plugin packaging iteration build. Run from a VS Developer Command Prompt.",
            "binaryDir": "${sourceDir}/build/ninja-iter-unreal-msvc",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "SMATCHET_UNREAL_THIRDPARTY_DIR": "${sourceDir}/UnrealPlugins/SmatchetImGuiPlugin/ThirdParty/Smatchet"
            }
        },
        {
            "name": "ninja-publish-msvc",
            "inherits": [
                "_smatchet-msvc-base"
            ],
            "displayName": "Ninja Publish (MSVC, LTO)",
            "description": "Distributable standalone plus Unreal packaging build with MSVC LTO. Builds SmatchetTests so ctest can gate publish.",
            "binaryDir": "${sourceDir}/build/ninja-publish-msvc",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "OFF",
                "SMATCHET_USE_PCH": "OFF",
                "SMATCHET_ENABLE_LTO": "ON",
                "SMATCHET_WINDOWS_FULLY_STATIC_RUNTIME": "ON",
                "SMATCHET_UNREAL_THIRDPARTY_DIR": "${sourceDir}/UnrealPlugins/SmatchetImGuiPlugin/ThirdParty/Smatchet",
                "SMATCHET_BUILD_TESTS": "ON"
            }
        },
        {
            "name": "ninja-publish-light-msvc",
            "inherits": [
                "_smatchet-msvc-base",
                "_smatchet-light-features"
            ],
            "displayName": "Ninja Publish Light (MSVC, LTO)",
            "description": "Distributable light standalone: Lua + command registry ON; MCP, AI, and Whisper OFF.",
            "binaryDir": "${sourceDir}/build/ninja-publish-light-msvc",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "OFF",
                "SMATCHET_USE_PCH": "OFF",
                "SMATCHET_ENABLE_LTO": "ON",
                "SMATCHET_WINDOWS_FULLY_STATIC_RUNTIME": "ON",
                "SMATCHET_STANDALONE_OUTPUT_NAME": "Smatchet-Light",
                "SMATCHET_STANDALONE_FILE_DESCRIPTION": "Smatchet Light Standalone",
                "SMATCHET_BUILD_TESTS": "OFF",
                "SMATCHET_BUILD_UI_TESTS": "OFF",
                "SMATCHET_BUILD_LUA_TESTS": "OFF",
                "SMATCHET_AGENT_DEBUG": "OFF",
                "SMATCHET_BUILD_AGENT_DEBUG_TESTS": "OFF"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "ninja-iter-msvc",
            "configurePreset": "ninja-iter-msvc",
            "inheritConfigureEnvironment": true,
            "targets": [
                "SmatchetStandalone"
            ]
        },
        {
            "name": "ninja-debug-msvc",
            "configurePreset": "ninja-debug-msvc",
            "inheritConfigureEnvironment": true,
            "targets": [
                "SmatchetStandalone"
            ]
        },
        {
            "name": "ninja-test-msvc",
            "configurePreset": "ninja-test-msvc",
            "inheritConfigureEnvironment": true,
            "targets": [
                "SmatchetTests",
                "SmatchetLuaTests"
            ]
        },
        {
            "name": "ninja-ui-test-msvc",
            "configurePreset": "ninja-ui-test-msvc",
            "inheritConfigureEnvironment": true,
            "targets": [
                "SmatchetStandalone"
            ]
        },
        {
            "name": "ninja-msvc-asan",
            "configurePreset": "ninja-msvc-asan",
            "inheritConfigureEnvironment": true,
            "targets": [
                "SmatchetStandalone"
            ]
        },
        {
            "name": "ninja-iter-clang",
            "configurePreset": "ninja-iter-clang",
            "inheritConfigureEnvironment": true,
            "targets": [
                "SmatchetStandalone"
            ]
        },
        {
            "name": "ninja-debug-clang",
            "configurePreset": "ninja-debug-clang",
            "inheritConfigureEnvironment": true,
            "targets": [
                "SmatchetStandalone"
            ]
        },
        {
            "name": "ninja-test-clang",
            "configurePreset": "ninja-test-clang",
            "inheritConfigureEnvironment": true,
            "targets": [
                "SmatchetTests",
                "SmatchetLuaTests"
            ]
        },
        {
            "name": "ninja-clang-asan",
            "configurePreset": "ninja-clang-asan",
            "inheritConfigureEnvironment": true,
            "targets": [
                "SmatchetStandalone"
            ]
        },
        {
            "name": "ninja-iter-unreal-msvc",
            "configurePreset": "ninja-iter-unreal-msvc",
            "inheritConfigureEnvironment": true,
            "targets": [
                "SmatchetPackageUnrealLibs_DX12"
            ]
        },
        {
            "name": "ninja-publish-msvc",
            "configurePreset": "ninja-publish-msvc",
            "inheritConfigureEnvironment": true,
            "targets": [
                "SmatchetStandalone",
                "SmatchetPackageUnrealLibs_DX12"
            ]
        },
        {
            "name": "ninja-publish-light-msvc",
            "configurePreset": "ninja-publish-light-msvc",
            "inheritConfigureEnvironment": true,
            "targets": [
                "SmatchetStandalone"
            ]
        }
    ]
}
