{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 24,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "_smatchet-native-features",
            "hidden": true,
            "description": "Shared SMATCHET_WITH_* defaults for presets that use the host PATH for compilers (legacy non-MSYS2 flow).",
            "cacheVariables": {
                "SMATCHET_WITH_LUA_AUTOMATION": "ON",
                "SMATCHET_WITH_MCP": "ON"
            }
        },
        {
            "name": "_smatchet-msys2-base",
            "hidden": true,
            "description": "Shared MSYS2 UCRT64 defaults for supported Smatchet workflows.",
            "generator": "Ninja",
            "environment": {
                "MSYSTEM": "UCRT64",
                "PATH": "$env{MSYSTEM_PREFIX}/bin;$env{MSYS2_ROOT}/usr/bin;$penv{PATH}",
                "CHERE_INVOKING": "1"
            },
            "cacheVariables": {
                "SMATCHET_WITH_LUA_AUTOMATION": "ON",
                "SMATCHET_WITH_MCP": "ON",
                "CMAKE_C_COMPILER": "gcc.exe",
                "CMAKE_CXX_COMPILER": "g++.exe",
                "CMAKE_AR": "ar.exe",
                "CMAKE_RANLIB": "ranlib.exe"
            }
        },
        {
            "name": "vs-unreal-msvc",
            "hidden": true,
            "inherits": [
                "_smatchet-native-features"
            ],
            "description": "Hidden MSVC preset for Win64 Unreal plugin packaging consumed by Unreal Build Tool.",
            "generator": "Visual Studio 17 2022",
            "binaryDir": "${sourceDir}/build/vs-unreal-msvc",
            "architecture": "x64",
            "cacheVariables": {
                "SMATCHET_UNREAL_THIRDPARTY_DIR": "${sourceDir}/UnrealPlugins/SmatchetImGuiPlugin/ThirdParty/Smatchet"
            }
        },
        {
            "name": "ninja-iter-msys2",
            "inherits": [
                "_smatchet-msys2-base"
            ],
            "displayName": "Ninja Iteration (MSYS2 UCRT64)",
            "description": "Recommended fast standalone developer build: RelWithDebInfo, compile_commands on, lld auto-detected when available.",
            "binaryDir": "${sourceDir}/build/ninja-iter-msys2",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "ninja-debug-msys2",
            "inherits": [
                "_smatchet-msys2-base"
            ],
            "displayName": "Ninja Debug (MSYS2 UCRT64)",
            "description": "Full standalone debug build with the MSYS2 UCRT64 toolchain. Builds SmatchetTests alongside SmatchetStandalone.",
            "binaryDir": "${sourceDir}/build/ninja-debug-msys2",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "SMATCHET_BUILD_TESTS": "ON"
            }
        },
        {
            "name": "ninja-test-msys2",
            "inherits": [
                "_smatchet-msys2-base"
            ],
            "displayName": "Ninja Tests (MSYS2 UCRT64)",
            "description": "Dedicated preset for the doctest rig under tests/. RelWithDebInfo for fast configure + run; iter preset stays test-free to keep iteration as fast as possible.",
            "binaryDir": "${sourceDir}/build/ninja-test-msys2",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "SMATCHET_BUILD_TESTS": "ON",
                "SMATCHET_BUILD_LUA_TESTS": "ON"
            }
        },
        {
            "name": "ninja-ui-test-msys2",
            "inherits": [
                "_smatchet-msys2-base"
            ],
            "displayName": "Ninja UI Tests (MSYS2 UCRT64)",
            "description": "ImGui Test Engine bucket-E surface. RelWithDebInfo, SMATCHET_BUILD_UI_TESTS=ON; builds Standalone + DX12 stub. Default presets stay engine-free.",
            "binaryDir": "${sourceDir}/build/ninja-ui-test-msys2",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "SMATCHET_BUILD_UI_TESTS": "ON",
                "SMATCHET_DEBUG_VISIBLE_CUE_HARNESS": "ON"
            }
        },
        {
            "name": "ninja-debug-msys2-asan",
            "inherits": [
                "_smatchet-msys2-base"
            ],
            "displayName": "Ninja Debug + AddressSanitizer + UBSan (MSYS2 UCRT64)",
            "description": "Debug build with -fsanitize=address,undefined for lifetime / bounds / UB bugs. ASan implies LSan on most platforms. Runtime overhead ~2-3x; libasan + libubsan must be on PATH at launch.",
            "binaryDir": "${sourceDir}/build/ninja-debug-msys2-asan",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "SMATCHET_SANITIZER": "asan"
            }
        },
        {
            "name": "ninja-debug-msys2-tsan",
            "inherits": [
                "_smatchet-msys2-base"
            ],
            "displayName": "Ninja Debug + ThreadSanitizer (MSYS2 UCRT64)",
            "description": "Debug build with -fsanitize=thread for data-race detection. MinGW-w64 GCC TSan support is partial / version-dependent on Windows; if symptoms surface, escalate to build-doctor. libtsan must be on PATH at launch.",
            "binaryDir": "${sourceDir}/build/ninja-debug-msys2-tsan",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "SMATCHET_SANITIZER": "tsan"
            }
        },
        {
            "name": "ninja-debug-msys2-msan",
            "inherits": [
                "_smatchet-msys2-base"
            ],
            "displayName": "Ninja Debug + MemorySanitizer — Clang required (MSYS2)",
            "description": "Debug build with -fsanitize=memory for uninit-read detection. MSan is Clang-only; MSYS2 GCC does NOT ship libmsan. Compilers are clang/clang++ resolved off PATH (no hardcoded paths). Install mingw-w64-clang-x86_64-clang in MSYS2 if missing. cmake/Sanitizers.cmake hard-fails at configure if the active compiler is not Clang.",
            "binaryDir": "${sourceDir}/build/ninja-debug-msys2-msan",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "SMATCHET_SANITIZER": "msan",
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++"
            }
        },
        {
            "name": "ninja-coverage-msys2",
            "inherits": [
                "_smatchet-msys2-base"
            ],
            "displayName": "Ninja Coverage (MSYS2 UCRT64, gcov-instrumented)",
            "description": "Coverage build for OpenCppCoverage / lcov+gcov. RelWithDebInfo + --coverage adds gcov instrumentation; OpenCppCoverage works against uninstrumented PDBs too but the instrumented build yields more accurate branch coverage on conditionals. Used by scripts/dev/coverage.sh.",
            "binaryDir": "${sourceDir}/build/ninja-coverage-msys2",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "SMATCHET_BUILD_TESTS": "ON",
                "SMATCHET_BUILD_LUA_TESTS": "ON",
                "CMAKE_C_FLAGS": "--coverage -fprofile-arcs -ftest-coverage",
                "CMAKE_CXX_FLAGS": "--coverage -fprofile-arcs -ftest-coverage",
                "CMAKE_EXE_LINKER_FLAGS": "--coverage",
                "CMAKE_SHARED_LINKER_FLAGS": "--coverage"
            }
        },
        {
            "name": "ninja-release",
            "inherits": [
                "_smatchet-native-features"
            ],
            "displayName": "Ninja Release",
            "description": "Legacy release preset that uses gcc/g++ from the current PATH and writes to build/ninja-release.",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/ninja-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++"
            }
        },
        {
            "name": "ninja-iter-unreal-msys2",
            "inherits": [
                "_smatchet-msys2-base"
            ],
            "displayName": "Ninja Unreal Iteration (MSYS2 UCRT64)",
            "description": "Fast Unreal plugin packaging iteration build: RelWithDebInfo, compile_commands on, Unreal third-party output enabled.",
            "binaryDir": "${sourceDir}/build/ninja-iter-unreal-msys2",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "SMATCHET_UNREAL_THIRDPARTY_DIR": "${sourceDir}/UnrealPlugins/SmatchetImGuiPlugin/ThirdParty/Smatchet"
            }
        },
        {
            "name": "ninja-debug-unreal-msys2",
            "inherits": [
                "_smatchet-msys2-base"
            ],
            "displayName": "Ninja Unreal Debug (MSYS2 UCRT64)",
            "description": "Debug Unreal plugin packaging build for reproducing Unreal-specific integration issues.",
            "binaryDir": "${sourceDir}/build/ninja-debug-unreal-msys2",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "SMATCHET_UNREAL_THIRDPARTY_DIR": "${sourceDir}/UnrealPlugins/SmatchetImGuiPlugin/ThirdParty/Smatchet"
            }
        },
        {
            "name": "ninja-publish-msys2",
            "inherits": [
                "_smatchet-msys2-base"
            ],
            "displayName": "Ninja Publish (MSYS2 UCRT64, LTO)",
            "description": "Distributable standalone plus Unreal packaging build using MSYS2 GCC LTO; forces BFD ld via SMATCHET_NO_LLD=1. Builds SmatchetTests so ctest can gate publish.",
            "binaryDir": "${sourceDir}/build/ninja-publish-msys2",
            "environment": {
                "SMATCHET_NO_LLD": "1"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "OFF",
                "SMATCHET_USE_PCH": "OFF",
                "SMATCHET_ENABLE_LTO": "ON",
                "SMATCHET_WINDOWS_FULLY_STATIC_RUNTIME": "ON",
                "SMATCHET_UNREAL_THIRDPARTY_DIR": "${sourceDir}/UnrealPlugins/SmatchetImGuiPlugin/ThirdParty/Smatchet",
                "SMATCHET_BUILD_TESTS": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "ninja-iter-msys2",
            "configurePreset": "ninja-iter-msys2",
            "inheritConfigureEnvironment": true,
            "targets": [
                "SmatchetStandalone"
            ]
        },
        {
            "name": "ninja-debug-msys2",
            "configurePreset": "ninja-debug-msys2",
            "inheritConfigureEnvironment": true,
            "targets": [
                "SmatchetStandalone"
            ]
        },
        {
            "name": "ninja-test-msys2",
            "configurePreset": "ninja-test-msys2",
            "inheritConfigureEnvironment": true,
            "targets": [
                "SmatchetTests",
                "SmatchetLuaTests"
            ]
        },
        {
            "name": "ninja-ui-test-msys2",
            "configurePreset": "ninja-ui-test-msys2",
            "inheritConfigureEnvironment": true,
            "targets": [
                "SmatchetStandalone"
            ]
        },
        {
            "name": "ninja-debug-msys2-asan",
            "configurePreset": "ninja-debug-msys2-asan",
            "inheritConfigureEnvironment": true,
            "targets": [
                "SmatchetStandalone"
            ]
        },
        {
            "name": "ninja-debug-msys2-tsan",
            "configurePreset": "ninja-debug-msys2-tsan",
            "inheritConfigureEnvironment": true,
            "targets": [
                "SmatchetStandalone"
            ]
        },
        {
            "name": "ninja-debug-msys2-msan",
            "configurePreset": "ninja-debug-msys2-msan",
            "inheritConfigureEnvironment": true,
            "targets": [
                "SmatchetStandalone"
            ]
        },
        {
            "name": "ninja-coverage-msys2",
            "configurePreset": "ninja-coverage-msys2",
            "inheritConfigureEnvironment": true,
            "targets": [
                "SmatchetTests",
                "SmatchetLuaTests"
            ]
        },
        {
            "name": "ninja-release",
            "configurePreset": "ninja-release",
            "inheritConfigureEnvironment": true,
            "targets": [
                "SmatchetStandalone"
            ]
        },
        {
            "name": "ninja-iter-unreal-msys2",
            "configurePreset": "ninja-iter-unreal-msys2",
            "inheritConfigureEnvironment": true,
            "targets": [
                "SmatchetPackageUnrealLibs_DX12"
            ]
        },
        {
            "name": "ninja-debug-unreal-msys2",
            "configurePreset": "ninja-debug-unreal-msys2",
            "inheritConfigureEnvironment": true,
            "targets": [
                "SmatchetPackageUnrealLibs_DX12"
            ]
        },
        {
            "name": "ninja-publish-msys2",
            "configurePreset": "ninja-publish-msys2",
            "inheritConfigureEnvironment": true,
            "targets": [
                "SmatchetStandalone",
                "SmatchetPackageUnrealLibs_DX12"
            ]
        }
    ]
}
