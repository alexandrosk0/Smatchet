{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 24,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "_smatchet-native-features",
            "hidden": true,
            "description": "Shared SMATCHET_WITH_* defaults for all presets; edit ON/OFF here (or override with cmake -D) so Standalone and Unreal-packaged libs stay aligned. Lua matches CMakeLists option default (ON).",
            "cacheVariables": {
                "SMATCHET_WITH_LUA_AUTOMATION": "ON",
                "SMATCHET_WITH_MCP": "ON",
                "SMATCHET_WITH_AI": "OFF"
            }
        },
        {
            "name": "ninja-debug",
            "inherits": [
                "_smatchet-native-features"
            ],
            "displayName": "Ninja Debug",
            "description": "Debug build with Ninja (requires Ninja on PATH)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/ninja-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "ninja-release",
            "inherits": [
                "_smatchet-native-features"
            ],
            "displayName": "Ninja Release",
            "description": "Release build with Ninja (requires Ninja on PATH)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/ninja-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "ninja-clang-debug",
            "inherits": [
                "_smatchet-native-features"
            ],
            "displayName": "Ninja Debug (Clang)",
            "description": "Debug + compile_commands.json using clang/clang++ on PATH (best match for clang-tidy)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/ninja-clang-debug",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "ninja-clang-release",
            "inherits": [
                "_smatchet-native-features"
            ],
            "displayName": "Ninja Release (Clang)",
            "description": "Release + compile_commands.json using clang/clang++ on PATH",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/ninja-clang-release",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "ninja-msvc-debug",
            "inherits": [
                "_smatchet-native-features"
            ],
            "displayName": "Ninja Debug (MSVC)",
            "description": "Debug build with Ninja and cl.exe from a Visual Studio developer shell",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/ninja-msvc-debug",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "cl",
                "CMAKE_CXX_COMPILER": "cl",
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "ninja-msvc-release",
            "inherits": [
                "_smatchet-native-features"
            ],
            "displayName": "Ninja Release (MSVC)",
            "description": "Release build with Ninja and cl.exe from a Visual Studio developer shell",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/ninja-msvc-release",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "cl",
                "CMAKE_CXX_COMPILER": "cl",
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "vs-debug",
            "inherits": [
                "_smatchet-native-features"
            ],
            "displayName": "Visual Studio Debug",
            "description": "Debug build with the Visual Studio 2022 generator",
            "generator": "Visual Studio 17 2022",
            "binaryDir": "${sourceDir}/build/vs-debug",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "vs-release",
            "inherits": [
                "_smatchet-native-features"
            ],
            "displayName": "Visual Studio Release",
            "description": "Release build with the Visual Studio 2022 generator",
            "generator": "Visual Studio 17 2022",
            "binaryDir": "${sourceDir}/build/vs-release",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "ninja-unreal-dx12",
            "inherits": [
                "_smatchet-native-features"
            ],
            "displayName": "Ninja Unreal DX12",
            "description": "Debug DX12 packaging using the compiler on PATH; use vs-unreal-dx12-release for MSVC ABI",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/ninja-unreal-dx12",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "SMATCHET_UNREAL_THIRDPARTY_DIR": "${sourceDir}/UnrealPlugins/SmatchetImGuiPlugin/ThirdParty/Smatchet"
            }
        },
        {
            "name": "ninja-unreal-dx12-release",
            "inherits": [
                "_smatchet-native-features"
            ],
            "displayName": "Ninja Unreal DX12 Release",
            "description": "Release DX12 packaging using the compiler on PATH; use vs-unreal-dx12-release for MSVC ABI",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/ninja-unreal-dx12-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "SMATCHET_UNREAL_THIRDPARTY_DIR": "${sourceDir}/UnrealPlugins/SmatchetImGuiPlugin/ThirdParty/Smatchet"
            }
        },
        {
            "name": "vs-unreal-dx12-release",
            "inherits": [
                "_smatchet-native-features"
            ],
            "displayName": "MSVC Unreal DX12 Release",
            "description": "Release DX12 artifacts packaged for Unreal plugin (MSVC ABI compatible)",
            "generator": "Visual Studio 17 2022",
            "binaryDir": "${sourceDir}/build/vs-unreal-dx12-release",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "SMATCHET_UNREAL_THIRDPARTY_DIR": "${sourceDir}/UnrealPlugins/SmatchetImGuiPlugin/ThirdParty/Smatchet"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "ninja-debug",
            "configurePreset": "ninja-debug"
        },
        {
            "name": "ninja-release",
            "configurePreset": "ninja-release"
        },
        {
            "name": "ninja-clang-debug",
            "configurePreset": "ninja-clang-debug"
        },
        {
            "name": "ninja-clang-release",
            "configurePreset": "ninja-clang-release"
        },
        {
            "name": "ninja-msvc-debug",
            "configurePreset": "ninja-msvc-debug"
        },
        {
            "name": "ninja-msvc-release",
            "configurePreset": "ninja-msvc-release"
        },
        {
            "name": "vs-debug",
            "configurePreset": "vs-debug",
            "configuration": "Debug"
        },
        {
            "name": "vs-release",
            "configurePreset": "vs-release",
            "configuration": "Release"
        },
        {
            "name": "ninja-unreal-dx12",
            "configurePreset": "ninja-unreal-dx12",
            "targets": [
                "SmatchetPackageUnrealLibs_DX12"
            ]
        },
        {
            "name": "ninja-unreal-dx12-release",
            "configurePreset": "ninja-unreal-dx12-release",
            "targets": [
                "SmatchetPackageUnrealLibs_DX12"
            ]
        },
        {
            "name": "vs-unreal-dx12-release",
            "configurePreset": "vs-unreal-dx12-release",
            "configuration": "Release",
            "targets": [
                "SmatchetPackageUnrealLibs_DX12"
            ]
        }
    ]
}