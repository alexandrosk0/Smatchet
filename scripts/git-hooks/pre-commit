#!/usr/bin/env bash
# pre-commit: two independent staged-file checks.
#
# (A) PILLAR-2 STATIC SCAN — cheap staged-file checks shared by harnesses that do
#     not have Claude Code's PostToolUse lint hook surface. Runs the harness-
#     agnostic Pillar 2 static scanner on staged first-party C++ files. It
#     intentionally skips non-C++ commits and deleted paths so docs/plan churn is
#     not blocked by an empty scanner invocation.
#
# (B) CODE-REVIEW ACK — refuse a commit whose STAGED diff is substantive C++ and
#     carries no review acknowledgement pinned to that exact diff content.
#     docs/agent-rules/process-rules.md § Code-review before every commit has
#     mandated a `code-review` pass before every commit since 2026-06-07, but the
#     only mechanical gate was CodeRabbit — which runs AFTER the commit, on the
#     PR. A session could stage a substantive diff, commit, and open a PR having
#     never dispatched `code-review`; an audit found exactly that about to happen.
#     Override: SMATCHET_SKIP_REVIEW_GATE=1 (logged; the same name the push-side
#     gate in scripts/dev/pre-ship.sh already uses).
#
# Wired via: git config --local core.hooksPath scripts/git-hooks  (installed
# by `bash agents/scripts/core/setup-harness.sh <harness>` when safe).

set -euo pipefail

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || echo "")"
if [[ -z "$repo_root" ]]; then
    exit 0
fi
cd "$repo_root"

# --- (A) Pillar 2 static scan ------------------------------------------------
mapfile -t cpp_files < <(
    git diff --cached --name-only --diff-filter=ACM \
        | grep -E '\.(c|cc|cpp|cxx|h|hh|hpp|hxx)$' \
        || true
)

# Existence (-f), not executability (-x): the scanner is run through `bash`, so
# its mode bit is irrelevant. An `-x` guard silently skipped the scan on every
# Linux/macOS commit while the file was tracked 100644 (Git Bash on Windows
# reports any `#!` file as executable, which hid it locally).
if [[ "${#cpp_files[@]}" -gt 0 ]]; then
    if [[ -f "scripts/dev/pillar2-scan.sh" ]]; then
        bash scripts/dev/pillar2-scan.sh "${cpp_files[@]}"
    else
        echo "pre-commit: WARN scripts/dev/pillar2-scan.sh missing; skipping Pillar 2 scan." >&2
    fi
fi

# --- (B) Code-review ack gate ------------------------------------------------
# Delegates the substantive-diff test and the fingerprint comparison to
# agents/scripts/core/review-ack.sh (shared with the push-side gate through
# agents/scripts/core/lib/review-ack.sh) so there is ONE implementation.
#   rc 0 = acked, or the staged diff is not substantive -> allow
#   rc 1 = substantive staged C++ with no current ack   -> BLOCK
#   rc 2 = infra/usage (not a work tree, bad flag)      -> WARN + allow
#   rc 3 = ack is current but carries a verifier HARD VETO -> BLOCK
#
# IN-PROGRESS MERGE / REVERT / CHERRY-PICK / REBASE ARE EXEMPT. Resolving a
# conflicted `git merge origin/develop` (the § Catch-up sync the ship-loop
# mandates) stages the ENTIRE merged C++ diff — none of it authored here, all of
# it already reviewed on its own PR. Gating that commit would wedge every
# catch-up sync behind either a pointless re-review of develop or the bypass
# env var, which trains the bypass into muscle memory. `git commit` is the only
# entry point git runs this hook from during those operations, so keying on the
# state files is exact.
git_dir="$(git rev-parse --git-dir 2>/dev/null || echo "")"
if [[ -n "$git_dir" ]]; then
    for state in MERGE_HEAD REVERT_HEAD CHERRY_PICK_HEAD; do
        if [[ -e "$git_dir/$state" ]]; then
            echo "pre-commit: code-review gate skipped — $state present (in-progress merge/revert/cherry-pick)." >&2
            exit 0
        fi
    done
    if [[ -d "$git_dir/rebase-merge" || -d "$git_dir/rebase-apply" ]]; then
        echo "pre-commit: code-review gate skipped — rebase in progress (replaying reviewed commits)." >&2
        exit 0
    fi
fi

# The gate is agent-layer content, run against this tree (the hook cd's to the
# top level above): the agent-layer/ mount once it holds the layer's
# project-config.sh (plan agent-surface-extraction-repo, row 12), else this tree.
# A registered mount that is not checked out (a plain `git worktree add`, or a
# clone without --recurse-submodules) has no gate to run, and skipping it would
# let an unreviewed commit through, so that state refuses with the remedy.
review_ack="agents/scripts/core/review-ack.sh"
if [[ -f agent-layer/scripts/dev/project-config.sh ]]; then
    review_ack="agent-layer/$review_ack"
elif [[ "$(git ls-files -s -- agent-layer 2>/dev/null | cut -c1-6)" == 160000 \
        && "${SMATCHET_SKIP_REVIEW_GATE:-0}" != "1" ]]; then
    echo "pre-commit: REFUSING — agent-layer/ is not checked out in this tree, so the code-review gate cannot run." >&2
    echo "  Fix: git submodule update --init --recursive agent-layer" >&2
    echo "  Override (trivial/emergency only): SMATCHET_SKIP_REVIEW_GATE=1 git commit ..." >&2
    exit 1
fi
if [[ ! -f "$review_ack" ]]; then
    echo "pre-commit: WARN $review_ack missing; skipping the code-review gate." >&2
    exit 0
fi

if [[ "${SMATCHET_SKIP_REVIEW_GATE:-0}" == "1" ]]; then
    echo "pre-commit: WARN — code-review gate bypassed (SMATCHET_SKIP_REVIEW_GATE=1)." >&2
    exit 0
fi

set +e
review_out="$(bash "$review_ack" --check --staged 2>&1)"
review_rc=$?
set -e

case "$review_rc" in
    0)
        exit 0
        ;;
    1)
        cat >&2 <<EOF

pre-commit: REFUSING a commit with no code review.

  $review_out

  Every commit's diff gets a 'code-review' agent pass BEFORE it lands
  (docs/agent-rules/process-rules.md § Code-review before every commit,
  user-mandated 2026-06-07). Critical/High findings block the commit until
  fixed or explicitly waived.

  1) run the code-review agent / adversarial-code-review skill on the STAGED
     diff (git diff --cached),
  2) fix or waive every Critical/High finding,
  3) record the ack:  bash $review_ack --record --staged
  4) commit again.

  Any later edit to a staged file re-arms this gate — that is the point.

  Override (trivial/emergency only — logged, discouraged):
    SMATCHET_SKIP_REVIEW_GATE=1 git commit ...
EOF
        exit 1
        ;;
    3)
        cat >&2 <<EOF

pre-commit: REFUSING — the code review recorded a HARD VETO.

  $review_out

  A veto is a security finding, a deterministic-gate failure, or a
  project-invariant breach — the reviewer marked it as something that must not
  be averaged away by good scores elsewhere (docs/agent-rules/verifier-sidecar.md
  § Operating rules, rule 2: veto beats average).

  This is NOT the advisory score. The continuous verifier score never blocks a
  commit until verifier-calibrate.py justifies promoting it; only a veto does.

  1) fix the vetoed issue,
  2) re-run the review on the corrected staged diff,
  3) record the new ack + verdict:
       bash $review_ack --record --staged --verdict <aggregate.json>
  4) commit again.

  If the veto is wrong, say so in the review and record a verdict without it —
  do not reach for the bypass to paper over a real finding.

  Override (emergency only — logged, discouraged):
    SMATCHET_SKIP_REVIEW_GATE=1 git commit ...
EOF
        exit 1
        ;;
    *)
        echo "pre-commit: WARN — code-review gate could not run (rc=$review_rc); allowing the commit." >&2
        echo "  $review_out" >&2
        exit 0
        ;;
esac
