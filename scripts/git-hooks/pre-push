#!/bin/bash
# pre-push: two independent local hard-stops.
#
# (A) DIRECT-PUSH-TO-PROTECTED-BRANCH — refuse a push whose destination ref is
#     refs/heads/develop or refs/heads/main. Such a push bypasses the PR / CI /
#     CodeRabbit / review gate entirely; owner admin creds bypass GitHub branch
#     protection too, so this LOCAL hook is the only stop. The recurring trigger:
#     the orchestrator is left on the develop branch by a merge-gate poller's
#     `git checkout develop`, then a bare `git push` sends develop -> develop.
#     Override: SMATCHET_ALLOW_DEVELOP_PUSH=1 (rare, sanctioned maintenance only).
#     Backlog: docs/self-improvement/categories/tooling.md
#       2026-06-05 · [tooling] · P1 — no local hard-stop on direct develop push
#       (escalated P2->P1, >=3 instances: a678741f / 578d21ea / 90cfd5d6).
#
# (B) MERGED-PR-BRANCH — refuse a push when the current branch's GitHub PR is
#     already MERGED or CLOSED (the commits would silently orphan: CI doesn't
#     fire, the PR view stays frozen, the commits land on a ref nothing reads).
#     Override: SMATCHET_ALLOW_MERGED_PR_PUSH=1 (rare, usually wrong; logged).
#     Backlog: docs/self-improvement/categories/process.md 2026-05-18 · P2.
#     Plan: docs/plans/shipped/process-backlog-tighten-1-2-3-9-11-12.md § Slice 3.
#
# Wired via: git config --local core.hooksPath scripts/git-hooks  (installed
# by `bash agents/scripts/core/setup-harness.sh <harness>` when safe).
#
# (B) skips silently when: branch is develop / main / detached HEAD; `gh` not on
# PATH; no PR for the branch; PR state OPEN. (A) ignores ref DELETES.

set -euo pipefail

# Dual-VCS drift check — runs first because it's orthogonal to the merged-PR
# refusal below. Silent no-op when SMATCHET_AGENT_VCS != p4 (default git
# users pay zero cost). See:
#   - agents/scripts/project/p4-reconcile-check.sh (the checker itself)
#   - docs/plans/shipped/git-to-perforce-migration.md § Files to modify §
#     scripts/git-hooks/pre-push:1
#   - AGENTS.md § Dual-VCS topology
repo_root="$(git rev-parse --show-toplevel 2>/dev/null || echo "")"
if [ -n "$repo_root" ] && [ -x "$repo_root/agents/scripts/project/p4-reconcile-check.sh" ]; then
    if ! bash "$repo_root/agents/scripts/project/p4-reconcile-check.sh"; then
        # Exit code 2 from p4-reconcile-check = drift detected + block mode.
        # The script already printed its own diagnostic; just propagate.
        exit 2
    fi
fi

# (A) Direct-push-to-protected-branch hard-stop. Parse the pre-push ref updates
# on stdin — each line is "<local_ref> <local_sha> <remote_ref> <remote_sha>".
# A non-delete update whose REMOTE ref is develop/main is a direct push to a
# protected branch (catches `git push`, `git push origin HEAD:develop`, and
# `git push origin local:develop` alike — more robust than the current branch).
zero_sha="0000000000000000000000000000000000000000"
protected_push=""
while read -r _local_ref local_sha remote_ref _remote_sha; do
    [ -n "$remote_ref" ] || continue
    [ "$local_sha" = "$zero_sha" ] && continue   # a branch DELETE — not a content push
    case "$remote_ref" in
        refs/heads/develop | refs/heads/main) protected_push="${remote_ref#refs/heads/}" ;;
    esac
done

if [ -n "$protected_push" ]; then
    cat >&2 <<EOF

pre-push: REFUSING direct push to '$protected_push'.

  A push that updates the '$protected_push' ref bypasses the PR / CI / CodeRabbit
  / review gate (owner admin creds bypass GitHub branch protection too — this
  local hook is the only stop). Almost always an accident: left on the
  '$protected_push' branch by a merge-gate poller's 'git checkout', then a bare
  'git push' sends '$protected_push' -> '$protected_push'.

  Ship through a PR instead:
    git checkout -b <slug> origin/develop
    ... commit ...
    git push -u origin <slug> && gh pr create

  Override (sanctioned maintenance only): SMATCHET_ALLOW_DEVELOP_PUSH=1 git push ...
EOF
    if [ "${SMATCHET_ALLOW_DEVELOP_PUSH:-0}" = "1" ]; then
        echo "pre-push: SMATCHET_ALLOW_DEVELOP_PUSH=1 set — proceeding with the '$protected_push' push." >&2
    else
        exit 1
    fi
fi

# (C) UNLOCKED-CONTENDED-PUSH hard-stop (Layer B of plan-lock enforcement).
#     Refuse a push when this branch's changed files overlap a refs/locks/*
#     write set owned by a DIFFERENT branch — the cross-branch collision the
#     lock exists to catch. Changed-file basis is branch-level + stdin-
#     INDEPENDENT (`$(git merge-base origin/develop HEAD)..HEAD`): (A)'s
#     `while read` already drained the ref-update stdin, so a second reader
#     gets EOF. Identity is keyed on BRANCH (never owner/AGENT_ID). Honours a
#     14-day staleness cutoff (symmetric with Layer C), so an aged orphan lock
#     is non-blocking. Override: SMATCHET_ALLOW_UNLOCKED_PUSH=1.
#
#     Placed BETWEEN (A) and (B) on purpose: (B) `exit 0`s for the normal
#     open-PR feature-branch case below, so a (C) after it is dead code for
#     exactly the contended push it must guard.
#
#     ADVISORY / FAIL-OPEN: the script runs `set -euo pipefail` (fail-CLOSED),
#     so the whole probe runs under a scoped `set +e` and ANY unknown (stale
#     origin/develop, unreachable lock ref, missing lib, parse error) ALLOWS
#     the push — it never rejects on uncertainty.
_pl_slug=""; _pl_file=""
if [ "${SMATCHET_ALLOW_UNLOCKED_PUSH:-0}" != "1" ]; then
    _planlock_probe() {
        [ -n "$repo_root" ] || return 0
        [ -f "$repo_root/agents/scripts/core/lock-table-cache.sh" ] || return 0
        local cur mb now cutoff f slug
        cur="$(git -C "$repo_root" symbolic-ref --quiet --short HEAD 2>/dev/null)"
        case "$cur" in ""|develop|main) return 0 ;; esac   # detached/protected -> skip
        # shellcheck source=agents/scripts/core/lock-table-cache.sh
        . "$repo_root/agents/scripts/core/lock-table-cache.sh" 2>/dev/null
        command -v ltc_covering_slug >/dev/null 2>&1 || return 0
        export LTC_PROJ="$repo_root"
        mb="$(git -C "$repo_root" merge-base origin/develop HEAD 2>/dev/null)"
        [ -n "$mb" ] || return 0
        now="$(date -u +%s 2>/dev/null)"; [ -n "$now" ] || return 0
        cutoff=$(( now - 14 * 24 * 3600 ))
        # Heredoc (not a pipe) so the loop body runs in this shell and its
        # assignments to _pl_* persist to the caller.
        while IFS= read -r f; do
            [ -n "$f" ] || continue
            slug="$(ltc_covering_slug "$f" other "$cur" "$cutoff" 2>/dev/null)"
            if [ -n "$slug" ]; then _pl_slug="$slug"; _pl_file="$f"; return 0; fi
        done <<PLPATHS
$(git -C "$repo_root" diff --name-only "$mb"..HEAD 2>/dev/null)
PLPATHS
        return 0
    }
    set +e
    _planlock_probe
    set -e
fi

if [ -n "$_pl_slug" ]; then
    cat >&2 <<EOF

pre-push: REFUSING push — plan-lock collision.

  Your change to '$_pl_file' overlaps the write set of plan-lock '$_pl_slug',
  held by a DIFFERENT branch. Two branches editing the same files race. Either
  coordinate, or if you legitimately own this file, extend that lock's set:
    bash agents/scripts/core/lock-claim-update.sh <slug> <full-write-set-file>

  Override (sanctioned, logged): SMATCHET_ALLOW_UNLOCKED_PUSH=1 git push ...
EOF
    exit 1
fi

branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "HEAD")

case "$branch" in
    develop|main|HEAD) exit 0 ;;
esac

# (D) LOCAL-CI DELTA-GATE — run the locally-runnable required-check mirrors on a
#     feature-branch push, so a locally-knowable lint / doc / format / shell
#     failure is caught HERE instead of reding the required `Comment-noise +
#     high-integrity gate`, `Doc anchors + agent contract`, or `Shell lint`
#     checks after the PR opens. That is the top re-push churn class
#     (`build-verify-shortcut-bypasses-comment-noise-and-lint-gate`, tooling
#     2026-06-18): the fast build-only verify path (`cmake --build`,
#     `build-and-run.sh --build-only`) skips these gates entirely, so the first
#     CI run is where the author learns. Parity matrix + the CI-only (Windows /
#     Mesa toolchain) residue this can NOT cover: docs/agent-rules/ci-local-parity.md.
#
#     Delta + path scoped: fast for docs / config / shell pushes (the C++
#     delta-audits early-exit); a first-party C++ change runs them, bounded by a
#     90s fail-open timeout. FAIL-CLOSED on a real violation; FAIL-OPEN on any
#     infra / missing-tool / unresolvable-base / timeout uncertainty (the gate
#     must never wedge a push on its OWN breakage or on a slow box).
#     Override (sanctioned, logged): SMATCHET_SKIP_PRESHIP_GATE=1.
if [ "${SMATCHET_SKIP_PRESHIP_GATE:-0}" = "1" ]; then
    echo "pre-push: SMATCHET_SKIP_PRESHIP_GATE=1 — skipping the local CI delta-gate." >&2
elif [ -n "$repo_root" ]; then
    ci_base=""
    ci_base="$(git -C "$repo_root" merge-base origin/develop HEAD 2>/dev/null || true)"
    if [ -n "$ci_base" ]; then
        ci_changed=""
        ci_changed="$(git -C "$repo_root" diff --name-only --diff-filter=d "$ci_base"..HEAD 2>/dev/null || true)"
        ci_fail=""
        # 1. Comment-noise + high-integrity + function-size + strict-zone + dup +
        #    include-cycle + fan-in — via the one delta gate. C++-gated to mirror
        #    CI's `if: changes.code == 'true'` trigger (docs/shell/config pushes
        #    skip it, staying fast). The C++ delta-audits each re-check the base
        #    worktree (~tens of seconds), so bound it with a 90s fail-OPEN
        #    timeout — a slow box never wedges a push (it falls back to
        #    pre-ship.sh + CI). exit 1 = real violation (block); 124 = timed out
        #    (fail-open + note); else infra (fail-open).
        if grep -qE '\.(c|cc|cpp|cxx|h|hpp|hxx)$' <<<"$ci_changed" \
           && [ -f "$repo_root/agents/scripts/project/test-lint-rules.sh" ]; then
            ci_rc=0
            if command -v timeout >/dev/null 2>&1; then
                ( cd "$repo_root" && timeout 90 bash agents/scripts/project/test-lint-rules.sh --diff origin/develop ) \
                    >/dev/null 2>&1 || ci_rc=$?
            else
                # No `timeout` (e.g. a stripped macOS / minimal shell): SKIP rather
                # than run unbounded — an unbounded run could hang the very push the
                # gate protects (CR #1556). Fail-open via the 124 path below;
                # pre-ship.sh + CI remain the full gate.
                ci_rc=124
            fi
            if [ "$ci_rc" -eq 1 ]; then
                ci_fail="$ci_fail
  - Comment-noise + high-integrity gate  (agents/scripts/project/test-lint-rules.sh)"
            elif [ "$ci_rc" -eq 124 ]; then
                echo "pre-push: NOTE — local lint gate skipped (no 'timeout' cmd, or it timed out); run 'bash scripts/dev/pre-ship.sh' for the full check." >&2
            fi
        fi
        # 2. Doc-validation mirror — only the develop-clean, delta-relevant doc
        #    checks that historically red a PR on push: doc-anchors (#953),
        #    markdown-links (#1156), portable-purity (#1394 doc-rename). NOT the
        #    full scripts/dev/test-docs.sh — that also runs the advisory auto-
        #    synced plan-INDEX check, which fails on pre-existing develop drift
        #    (CI auto-fixes it, never blocks) and would false-block an unrelated
        #    push. A false-blocking gate trains override-by-reflex.
        if grep -qE '\.md$|^agents/|^docs/|^project\.config\.json$' <<<"$ci_changed"; then
            for ci_doc in test-doc-anchors test-markdown-links test-portable-purity; do
                [ -f "$repo_root/agents/scripts/core/$ci_doc.sh" ] || continue
                if ! ( cd "$repo_root" && bash "agents/scripts/core/$ci_doc.sh" ) >/dev/null 2>&1; then
                    ci_fail="$ci_fail
  - $ci_doc  (agents/scripts/core/$ci_doc.sh)"
                fi
            done
        fi
        # 3. clang-format reflow (folds into the required `Windows + MSVC` lint
        #    step) — changed first-party C++ only, and only if clang-format is
        #    installed (else fail-open). Delta-aware to match the CI gate:
        #    `git clang-format --diff <base> HEAD` flags only the changed hunks,
        #    so pre-existing drift elsewhere in a touched file can't block an
        #    unrelated change. No git-clang-format → whole-file fallback (says
        #    it is stricter than the CI delta). rc=1 is the violation verdict;
        #    any other non-zero is infra → fail-open.
        if command -v clang-format >/dev/null 2>&1; then
            ci_cpp=""
            ci_cpp="$(grep -E '^(Source|tests)/.*\.(c|cc|cpp|cxx|h|hpp|hxx)$' <<<"$ci_changed" || true)"
            if [ -n "$ci_cpp" ]; then
                ci_fmt_bad=0
                ci_fmt_note=""
                if command -v git-clang-format >/dev/null 2>&1; then
                    ci_cpp_files=()
                    while IFS= read -r ci_f; do
                        [ -n "$ci_f" ] && ci_cpp_files+=("$ci_f")
                    done <<<"$ci_cpp"
                    ci_fmt_rc=0
                    ( cd "$repo_root" && git clang-format --diff "$ci_base" HEAD -- "${ci_cpp_files[@]}" ) \
                        >/dev/null 2>&1 || ci_fmt_rc=$?
                    [ "$ci_fmt_rc" -eq 1 ] && ci_fmt_bad=1
                else
                    while IFS= read -r ci_f; do
                        [ -n "$ci_f" ] || continue
                        ( cd "$repo_root" && clang-format --dry-run --Werror "$ci_f" ) >/dev/null 2>&1 \
                            || ci_fmt_bad=1
                    done <<<"$ci_cpp"
                    ci_fmt_note=" [whole-file — stricter than the CI delta; install git-clang-format for hunk-scoped]"
                fi
                if [ "$ci_fmt_bad" -ne 0 ]; then
                    ci_fail="$ci_fail
  - clang-format reflow${ci_fmt_note}  (run: bash scripts/dev/pre-ship.sh  to auto-format)"
                fi
            fi
        fi
        # 4. Shell lint (`Shell lint (shellcheck)`) — only when a .sh changed AND
        #    shellcheck is installed (else fail-open).
        if grep -qE '\.sh$' <<<"$ci_changed" \
           && command -v shellcheck >/dev/null 2>&1 \
           && [ -f "$repo_root/agents/scripts/core/test-lint-bash.sh" ]; then
            if ! ( cd "$repo_root" && bash agents/scripts/core/test-lint-bash.sh ) >/dev/null 2>&1; then
                ci_fail="$ci_fail
  - Shell lint (shellcheck)  (agents/scripts/core/test-lint-bash.sh)"
            fi
        fi
        if [ -n "$ci_fail" ]; then
            printf '\npre-push: REFUSING push — local CI delta-gate found failures CI would red on:\n%s\n\n' "$ci_fail" >&2
            printf '  These are locally-knowable failures the fast build-only verify path skips.\n' >&2
            printf '  Fix (most auto-fix):  bash scripts/dev/pre-ship.sh   then re-push.\n' >&2
            printf '  Parity matrix: docs/agent-rules/ci-local-parity.md\n' >&2
            printf '  Override (sanctioned, logged): SMATCHET_SKIP_PRESHIP_GATE=1 git push ...\n\n' >&2
            exit 1
        fi
    fi
fi

if ! command -v gh >/dev/null 2>&1; then
    exit 0
fi

pr_state=$(gh pr view "$branch" --json state --jq .state 2>/dev/null || true)
if [ -z "$pr_state" ] || [ "$pr_state" = "OPEN" ]; then
    exit 0
fi

pr_number=$(gh pr view "$branch" --json number --jq .number 2>/dev/null || echo "?")

cat >&2 <<EOF

pre-push: REFUSING push.

  branch:    $branch
  PR #$pr_number state: $pr_state

Pushing to a $pr_state PR branch silently lands commits the PR will never
pick up. Open a follow-up branch from develop instead:

  git checkout -b <new-branch> origin/develop
  git cherry-pick <sha1> <sha2> ...      # or re-apply changes
  git push -u origin <new-branch>
  gh pr create --draft

Override (rare, usually wrong): SMATCHET_ALLOW_MERGED_PR_PUSH=1 git push ...
EOF

if [ "${SMATCHET_ALLOW_MERGED_PR_PUSH:-0}" = "1" ]; then
    echo "pre-push: SMATCHET_ALLOW_MERGED_PR_PUSH=1 set — proceeding anyway." >&2
    exit 0
fi

exit 1
