#!/usr/bin/env bash
# =============================================================================
# ARCHIVED — DO NOT EXECUTE. File extension `.sh.archived` keeps this script
# out of `scripts/dev/test-all.sh`'s `test-*.sh` auto-enrolment glob. Original
# location: `scripts/dev/test-norton-theme.sh`.
#
# Why archived: drives `tests/ui/archived/norton_commander_theme.test.cpp.archived`
# (also archived) — the test asserts the PR #91 blue palette which PR #105
# retuned to teal. Removed from the live build until the palette is locked.
#
# To revive: copy this file to `scripts/dev/test-norton-theme.sh`, drop the
# `.archived` extension, restore the matching test from
# `tests/ui/archived/norton_commander_theme.test.cpp.archived`, re-add the
# `extern "C"` line in `tests/ui/ui_tests_registry.cpp` and the source in
# `tests/ui/CMakeLists.txt` _SMATCHET_UI_TEST_SOURCES list.
#
# Tracked: `docs/backlog/BACKLOG_PLANS.md` § 2.
# =============================================================================

# test-norton-theme.sh — bucket-E driver for the NortonCommander theme live-apply
# test. Spawns an ephemeral Smatchet built with SMATCHET_BUILD_UI_TESTS=ON,
# invokes ui_test.run with the NortonCommander filter, parses the JSON envelope,
# reports Passed / Failed.
#
# Verifies that the apply path runs cleanly through the live ImGuiContext owned
# by the running standalone app (real font, real platform, real frame loop) and
# writes the expected chrome + syntax palette values. Doctest covers the same
# claim in isolation; this script covers the live ImGui state path.
#
# Exit codes:
#   0 — every test passed
#   1 — at least one test failed
#   2 — binary missing OR build had SMATCHET_BUILD_UI_TESTS=OFF

set -euo pipefail

cd "$(dirname "$0")/../.."

EXE="${SMATCHET_EXE:-build/ninja-ui-test-msys2/Smatchet.exe}"
PY="${PYTHON:-python}"
TEST_PORT="${SMATCHET_TEST_PORT:-58741}"
FILTER="${UI_TEST_FILTER:-NortonCommander}"

if [ ! -f "$EXE" ]; then
    echo "FAIL: $EXE not found. Build with: cmake --build --preset ninja-ui-test-msys2 --target SmatchetStandalone" >&2
    exit 2
fi

echo "[test-norton-theme] launching ephemeral Smatchet (port $TEST_PORT)..."
RAW_OUTPUT="$("$EXE" cmd ui_test.run --name="$FILTER" --spawn --yes \
    --port="$TEST_PORT" 2>&1 || true)"

echo "$RAW_OUTPUT" | tail -40

JSON_LINE="$(echo "$RAW_OUTPUT" | grep -oE '\{.*\}' | tail -1 || true)"
if [ -z "$JSON_LINE" ]; then
    echo "FAIL: could not extract JSON envelope from ui_test.run output" >&2
    echo "Passed: 0  Failed: 1"
    exit 1
fi

PASSED="$(echo "$JSON_LINE" | "$PY" -c "import sys,json; d=json.load(sys.stdin); print(d.get('data',{}).get('passed','?'))" 2>/dev/null || echo "?")"
FAILED="$(echo "$JSON_LINE" | "$PY" -c "import sys,json; d=json.load(sys.stdin); print(d.get('data',{}).get('failed','?'))" 2>/dev/null || echo "?")"
LOG="$(echo "$JSON_LINE" | "$PY" -c "import sys,json; d=json.load(sys.stdin); print(d.get('data',{}).get('log','?'))" 2>/dev/null || echo "?")"

echo
echo "Result: passed=$PASSED failed=$FAILED log=$LOG"

if [ "$LOG" = "build had SMATCHET_BUILD_UI_TESTS=OFF" ]; then
    echo "FAIL: build had SMATCHET_BUILD_UI_TESTS=OFF — rebuild with ninja-ui-test-msys2." >&2
    echo "Passed: 0  Failed: 0"
    exit 2
fi

if [ "$PASSED" = "?" ] || [ "$FAILED" = "?" ]; then
    echo "Passed: 0  Failed: 1"
    exit 1
fi

echo "Passed: $PASSED  Failed: $FAILED"
if [ "$FAILED" != "0" ]; then
    exit 1
fi
exit 0
