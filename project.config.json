{
  "$schema": "./project.config.schema.json",
  "_doc": "Single home for project-specific values consumed by the portable agentic layer. Reuse in another project = copy the portable tree (agents/core, agents/_shared, docs/agent-rules, docs/harness, the self-improvement framework + generic scripts) and rewrite THIS file. See docs/PORTABILITY.md. Prose in AGENTS.md / docs/agent-rules points here for parameterized facts; scripts source scripts/dev/project-config.sh.",
  "project": {
    "name": "Smatchet",
    "env_prefix": "SMATCHET",
    "literals": [
      "Smatchet",
      "Source/Core",
      "Source/Standalone",
      "Source/UnrealPlugins",
      "SmatchetStandalone",
      "SmatchetCore_DX12",
      "DX12",
      "ITrackerClient"
    ]
  },
  "build": {
    "presets": ["ninja-iter-msvc", "ninja-test-msvc", "ninja-msvc-asan", "ninja-publish-msvc"],
    "targets": ["SmatchetStandalone", "SmatchetCore_DX12"],
    "exe_path": "build/{preset}/Smatchet.exe",
    "msvc_toolset_pin": "14.38"
  },
  "perf": {
    "frame_budget_ms": 6.94,
    "fps_floor_ms": 10.0,
    "freeze_ms": 100,
    "baselines_dir": "docs/perf/baselines",
    "policy": "docs/perf/regression-policy.json"
  },
  "lint": {
    "zones": {
      "strict": [
        "Source/Core/src/Tracker/",
        "Source/Core/src/Sync/",
        "Source/Core/src/Persistence/",
        "Source/Core/src/Config/",
        "Source/Core/src/Commands/",
        "Source/Plugins/Mcp/"
      ],
      "light": ["Source/Core/src/Ui/", "Source/Core/include/Ui/", "Source/Standalone/"],
      "exempt": ["ThirdParty", "build"]
    },
    "rules": ["no-printf-stderr", "no-raw-new", "narrowing-conversions", "define-imgui", "deviation-overdue"],
    "deviation_keyword": "SMATCHET_DEVIATION",
    "baseline": "docs/high-integrity/baseline.md"
  },
  "vcs": {
    "primary": "git",
    "optional_layer": "p4",
    "p4_streams": [],
    "protected_branches": ["bug-report-assets"]
  },
  "branch_protection": {
    "branch": "develop",
    "required_contexts": [
      "Test-delta gate",
      "Windows + MSVC",
      "Windows + MSVC (Smatchet light — AI/Whisper/MCP off)",
      "Windows + MSVC (ARM64 cross-compile)",
      "Comment-noise + high-integrity gate",
      "Shell lint (shellcheck)",
      "Doc anchors + agent contract",
      "Perf PR-fast (windows-2022)",
      "Coverage (windows-2022 + OpenCppCoverage)",
      "Sanitizer (ASAN via MSVC)",
      "Sanitizer (UBSan via Clang)",
      "Agentic self-tests (bats)",
      "Duplication scanner",
      "CR finding gate",
      "Pillar 2 scanner",
      "Plan-lock gate",
      "Intent section",
      "Android security gate (manifest + TLS fail-fast)",
      "High-integrity baseline (develop drift)",
      "High-integrity narrowing (clang)",
      "Packaging graph smoke (SmatchetPackageUnrealLibs_DX12)",
      "Bucket launch-smoke (Mesa GL)",
      "Bucket-C screenshot diff (Mesa headless GL)",
      "Bucket-E UI tests (Mesa headless GL)",
      "Bucket-E Jira fixture-backend (Mesa GL, hard)",
      "Mobile texture-guard smoke (Mesa headless GL)",
      "Mobile — POSIX core compile gate (Linux clang)",
      "Mobile — Android NDK arm64-v8a (.so configure+link)",
      "Mobile — Android APK (Gradle assembleDebug arm64-v8a)",
      "C++ lint (catch-all + cppcheck)"
    ],
    "required_review_count": 0,
    "enforce_admins": false,
    "strict": false
  },
  "ci": {
    "required_checks": [
      "Test-delta gate",
      "Windows + MSVC",
      "Windows + MSVC (Smatchet light — AI/Whisper/MCP off)",
      "Windows + MSVC (ARM64 cross-compile)",
      "Comment-noise + high-integrity gate",
      "Shell lint (shellcheck)",
      "Doc anchors + agent contract",
      "Perf PR-fast (windows-2022)",
      "Coverage (windows-2022 + OpenCppCoverage)",
      "Sanitizer (ASAN via MSVC)",
      "Sanitizer (UBSan via Clang)",
      "Agentic self-tests (bats)",
      "Duplication scanner",
      "CR finding gate",
      "Pillar 2 scanner",
      "Plan-lock gate",
      "Intent section",
      "Android security gate (manifest + TLS fail-fast)",
      "High-integrity baseline (develop drift)",
      "High-integrity narrowing (clang)",
      "Packaging graph smoke (SmatchetPackageUnrealLibs_DX12)",
      "Bucket launch-smoke (Mesa GL)",
      "Bucket-C screenshot diff (Mesa headless GL)",
      "Bucket-E UI tests (Mesa headless GL)",
      "Bucket-E Jira fixture-backend (Mesa GL, hard)",
      "Mobile texture-guard smoke (Mesa headless GL)",
      "Mobile — POSIX core compile gate (Linux clang)",
      "Mobile — Android NDK arm64-v8a (.so configure+link)",
      "Mobile — Android APK (Gradle assembleDebug arm64-v8a)",
      "C++ lint (catch-all + cppcheck)"
    ],
    "path_filters": {
      "code_globs": ["Source/**"],
      "docs_ignore": ["**/*.md", "docs/**", "agents/**", ".gitignore", ".gitattributes", ".coderabbit.yaml"]
    }
  },
  "merge_gates": {
    "cr_bot_logins": ["coderabbitai[bot]", "coderabbitai"],
    "override_labels": ["tests-out-of-band", "perf-out-of-band", "cr-out-of-band", "coverage-out-of-band", "intent-out-of-band"]
  },
  "coverage": {
    "_doc": "Numeric line-coverage gate (coverage.yml). threshold = blocking floor; excluded = paths carved out of the measured surface (UI is bucket-E/screenshot-tested, not ctest-testable). Graduated advisory->blocking 2026-06-04; first real measurement 67%, floor set at 65 with a raise-to-70 ramp (categories/test.md). See docs/plans/shipped/coverage-threshold-graduation.md.",
    "threshold": 65,
    "ramp_target": 70,
    "excluded": ["Source/Core/src/Ui", "Source/Core/include/Ui"]
  },
  "visual_validation": {
    "_doc": "Globs over TRACKED source whose edit warrants visual verification (Pillar 4). The localization strings live in the C++ string table SmatchetLocalization.cpp (+ its headers), NOT in a tracked Locales/*.json — those are user-supplied runtime override files placed next to the exe and are never committed (README § localization). The earlier `**/Locales/*.json` glob matched zero tracked files; a zero-match glob is dead config. test-config-globs.sh asserts every glob here matches >=1 tracked file.",
    "trigger_globs": ["**/SmatchetTheme.cpp", "**/Smatchet*Ui*.cpp", "**/SmatchetLocalization.cpp", "**/SmatchetLocaliz*.h"]
  },
  "golden": {
    "artifacts_dir": "tests/golden"
  },
  "harness": {
    "discovery_mode": "flat-symlink",
    "supported": ["claude-code", "codex", "cursor"]
  },
  "guards": {
    "doc_validation": [
      "test-plan-index",
      "test-plan-naming",
      "test-plan-ref-integrity",
      "test-plan-archived",
      "test-portable-purity",
      "test-config-globs",
      "test-markdown-links"
    ]
  },
  "docs": {
    "taxonomy_exceptions": []
  },
  "subsystems": [
    { "name": "tracker", "agents": ["tracker-backend"] },
    { "name": "grid", "agents": ["grid-engine"] },
    { "name": "lua", "agents": ["lua-binder"] },
    { "name": "mcp", "agents": ["mcp-toolsmith"] },
    { "name": "offline-sync", "agents": ["offline-sync"] },
    { "name": "unreal", "agents": ["unreal-bridge"] },
    { "name": "p4-annotate", "agents": ["p4-annotate"] },
    { "name": "commands", "agents": ["command-system"] }
  ],
  "agents": {
    "_doc": "size_*: line budgets for agent_size_audit.py (reduce-agent-prompt-bloat Slice 0). size_budget/warn = agent-prompt class (agents/core, agents/project); contract_* = AGENTS.md; sink_warn = soft-warn-only sinks (docs/agent-rules, agents/_shared/skills). Hard caps BLOCK (delta-gated + grandfathered); sinks never block. KEEP IN SYNC with the agent_size_audit.py constants (its --selftest asserts equality).",
    "enabled_project": [
      "tracker-backend",
      "grid-engine",
      "lua-binder",
      "mcp-toolsmith",
      "offline-sync",
      "unreal-bridge",
      "p4-annotate",
      "command-system"
    ],
    "size_budget_lines": 250,
    "size_warn_lines": 150,
    "contract_budget_lines": 150,
    "contract_warn_lines": 120,
    "sink_warn_lines": 400
  },
  "governance": {
    "_doc": "Human-authority charter defaults (AI_POLICY.md). loop_mode / auto_merge are the committed operator defaults, read at SessionStart by agents/scripts/core/clear-session-context.sh when the matching env var (SMATCHET_LOOP_MODE / SMATCHET_AUTOMERGE) is unset; the env var overrides per session. loop_mode 'on' = action-biased human-on-the-loop, 'in' = plan-gated human-in-the-loop. auto_merge 'on' is a STANDING, revocable grant: the orchestrator auto-merges a PR once the full merge-gates poll passes (safe-merge.sh) WITHOUT the per-PR post-ship merge prompt — the gates still bind; only the asking is removed (set 2026-06-23: solo maintainer, low review availability).",
    "policy": "AI_POLICY.md",
    "loop_mode": "on",
    "auto_merge": "on"
  }
}
