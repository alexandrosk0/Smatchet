<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Chromebook (ARC) readiness: Smatchet is a keyboard + mouse/trackpad app, not a
         touch-first one. Android assumes an app REQUIRES a touchscreen unless told otherwise,
         which makes Google Play hide it from non-touch Chromebooks (and other large-screen
         devices). Declaring the touch features not-required keeps phones/tablets unaffected
         while making the app installable across the full Chromebook range. See
         docs/mobile/CHROMEBOOK_PORT_INVESTIGATION.md - Path A (gap A8). -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen.multitouch" android:required="false" />

    <!-- resizeableActivity=true: explicit large-screen / freeform / split-screen support.
         It already defaults true at targetSdk 24+, but declaring it states intent and
         future-proofs against the default changing; recommended for ChromeOS windowing. -->
    <application
        android:allowBackup="false"
        android:label="Smatchet"
        android:resizeableActivity="true"
        android:hasCode="true">
        <!-- allowBackup=false (Issue #1067): the app's private files dir holds the
             extracted CA bundle and (once Keystore lands) credential material.
             allowBackup=false disables cloud Auto Backup and adb backup of that dir.
             SCOPE LIMIT — on API 31+ (this app: targetSdk 34) it does NOT cover
             device-to-device (D2D) transfer; that channel is governed by
             android:dataExtractionRules <device-transfer>, which is not set here.
             Closing the D2D path is Keystore-time work (epic #1018): add a
             dataExtractionRules resource with a <device-transfer> exclude alongside
             the secure-storage migration. -->

        <activity
            android:name=".SmatchetActivity"
            android:exported="true"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|density|uiMode"
            android:windowSoftInputMode="adjustResize">

            <meta-data
                android:name="android.app.lib_name"
                android:value="SmatchetMobile" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
