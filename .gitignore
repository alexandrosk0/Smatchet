# FetchContent clones / Lua tarball (shared across build dirs; see FETCHCONTENT_BASE_DIR in CMakeLists)
.fetchcontent-src/

# Build output / cache
build/
build_*/
**/CMakeFiles/
**/CMakeCache.txt
**/cmake_install.cmake
**/*.cmake.user
CMakeUserPresets.json
compile_commands.json

# C/C++
*.o
*.obj
*.a
*.lib
*.dll
*.so
*.dylib
*.exe
*.pdb
*.ilk
*.exp
*.map

# IDEs
.vs/
.vscode/*
!.vscode/settings.json
.idea/
cmake-build-*/
out/

# OS
Thumbs.db
Desktop.ini

# Secrets / local config
.env
*.key
*.pem
*.pfx
credentials*.json
# Exception: the vendored Mozilla CA root bundle is a public artifact (not a
# secret) that ships in the Android APK; see THIRD_PARTY_LICENSES.md.
!Source/Mobile/AndroidApp/app/src/main/assets/certs/cacert.pem

# App local state / logs
Smatchet_LocalCache.sqlite
Smatchet_LocalCache.sqlite-wal
Smatchet_LocalCache.sqlite-shm
*.log
imgui.ini
smatchet_config.json
smatchet_views.json
smatchet_backend_audit.jsonl
smatchet_field_catalog_cache.json

.worktrees/

# Harness adapters — local-only, regenerate via `bash agents/scripts/core/setup-harness.sh <name>`.
# See docs/harness/SETUP.md for per-harness instructions.
.claude/
.codex/
# .cursor/ stays local EXCEPT .cursor/BUGBOT.md, which is shared Cursor Bugbot
# review config (like the committed .coderabbit.yaml) and must be tracked so
# Bugbot reads it on every PR. `.cursor/*` keeps the rest (rules/, etc.) ignored.
.cursor/*
!.cursor/BUGBOT.md
.pi/

# caveman (https://github.com/JuliusBrussee/caveman) — user-installed; see AGENTS.md
.agents/
skills-lock.json

# Per-session orchestrator scratchpad (see AGENTS.md § Session scratchpad protocol)
.session-context.md
.session-context.archive/

# Per-branch redacted prompt-intent capture (see docs/agent-rules/ship-loops.md
# § Intent capture). Written by the capture-intent.sh UserPromptSubmit hook,
# read by the orchestrator at gh pr create time to fill the PR `## Intent`.
.session-intent/

# Per-run coderabbit-triage temp dumps (see agents/coderabbit-triage.md)
.triage-reviews.json
.triage-review-comments.json
.triage-issue-comments.json

# Per-investigation debug-detective artifacts (see agents/debug-detective.md).
# Directory contents gitignored EXCEPT the production-resident slice-7 helper.
# (Distinct from the per-investigation template — see plan-doc § Coexistence.)
debug-*.log
Smatchet-debug-*.log
tests/_debug/*
!tests/_debug/.gitkeep
!tests/_debug/SmatchetAgentDebug.h
*.cppcheck
*.sln
*.vcxproj
*.filters
*.user
/smatchet-cppcheck-build-dir
cppcheck_*.txt
/.fetchcontent-msvc
BUILD_ITERATION_PLAN.md
.vscode/settings.json
backlog/CPPCHECK_PLAN.md
backlog/RICH_TEXT_EDITING_V3_PLAN.md
screenshot_*
smatchet_config.json.lock
.progress.log
*.pyc

# Font Awesome 6 Solid TTF — Phase 4 of ai-chat-claude-desktop-parity. Binary
# asset (~426 KB, SIL OFL 1.1) deliberately NOT tracked in git per the design
# contract — devs drop it manually using assets/fonts/README.md, CI fetches on
# release-tag builds. Scoped to assets/fonts/ so other vendored .ttf elsewhere
# in the tree (if any future plugin ships one) is unaffected.
assets/fonts/*.ttf

# Per-clone p4 client config (host-specific; never committed). .p4config
# files override P4PORT / P4USER / P4CLIENT / P4IGNORE per folder and are
# used on machines like Brick that run multiple p4d contexts (e.g. local
# Unreal p4d + remote Mainbot p4d) where global env vars would collide.
.p4config

# Copilot-instructions variant is generated per-harness, not committed.
.github/copilot-instructions.md

# Per-subsystem Claude Code shims: setup-harness.sh generates a one-line
# CLAUDE.md (@AGENTS.md) beside each Source/Core/src/<ctx>/AGENTS.md so Claude
# Code lazy-loads the leaf rules (it reads nested CLAUDE.md, not nested
# AGENTS.md). The committed tree stays AGENTS.md-only; the shim is local adapter
# output. See AGENTS.md § Subsystem guides + CONTEXT-MAP.md § Harness discovery.
Source/Core/src/**/CLAUDE.md

# pre-ship.sh code-review gate marker (local, HEAD/diff-pinned ack)
.review-ack
.git-msg.tmp

# LocalCacheManager corruption-test droppings (SmatchetTests run from the repo root)
smatchet_lcm_*.db.corrupt-*
