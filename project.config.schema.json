{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://smatchet/project.config.schema.json",
  "title": "Project config — the project-specific value table for the portable agentic layer",
  "description": "Validated in CI. The portable layer (agents/core, agents/_shared, docs/agent-rules, docs/harness, generic scripts) reads ONLY from here; reuse in another project = rewrite project.config.json against this schema. See docs/PORTABILITY.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["project", "build", "perf", "lint", "vcs", "ci", "merge_gates", "harness", "agents"],
  "properties": {
    "$schema": { "type": "string" },
    "_doc": { "type": "string" },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "env_prefix", "literals"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "env_prefix": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "literals": {
          "type": "array",
          "description": "Project-specific identifiers that must NOT appear in portable files (the portable-purity denylist seed). Names, dirs, target/interface symbols.",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["presets", "targets", "exe_path"],
      "properties": {
        "presets": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "targets": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "exe_path": { "type": "string" },
        "msvc_toolset_pin": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$",
          "description": "Optional, Windows-only. MSVC toolset version (major.minor) to pin vcvars64 to on a multi-VS box, so a newer side-by-side toolset doesn't load STL headers that break the cached cl.exe (STL1001). Read by scripts/dev/with-msvc-env.sh (bash) and scripts/dev/local/build-msvc-asan.sh; overridable via $SMATCHET_VCVARS_VER."
        }
      }
    },
    "perf": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frame_budget_ms", "fps_floor_ms", "freeze_ms", "baselines_dir", "policy"],
      "properties": {
        "frame_budget_ms": { "type": "number", "exclusiveMinimum": 0 },
        "fps_floor_ms": { "type": "number", "exclusiveMinimum": 0 },
        "freeze_ms": { "type": "number", "exclusiveMinimum": 0 },
        "baselines_dir": { "type": "string" },
        "policy": { "type": "string" }
      }
    },
    "lint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zones", "rules", "deviation_keyword", "baseline"],
      "properties": {
        "zones": {
          "type": "object",
          "additionalProperties": false,
          "required": ["strict", "light", "exempt"],
          "properties": {
            "strict": { "type": "array", "items": { "type": "string" } },
            "light": { "type": "array", "items": { "type": "string" } },
            "exempt": { "type": "array", "items": { "type": "string" } }
          }
        },
        "rules": { "type": "array", "items": { "type": "string" } },
        "deviation_keyword": { "type": "string" },
        "baseline": { "type": "string" }
      }
    },
    "vcs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary"],
      "properties": {
        "primary": { "type": "string" },
        "optional_layer": { "type": ["string", "null"] },
        "p4_streams": { "type": "array", "items": { "type": "string" } },
        "protected_branches": {
          "type": "array",
          "description": "Branches the stale-branch sweep (git-janitor) must NEVER delete even with no open PR — load-bearing infra (e.g. a relay/asset-host branch referenced by committed code). Mechanism is portable; this list is the project-specific value.",
          "items": { "type": "string" }
        }
      }
    },
    "branch_protection": {
      "type": "object",
      "additionalProperties": false,
      "description": "Desired GitHub branch-protection state for the default branch, codified so it can't drift. Applied by agents/scripts/core/setup-branch-protection.sh. See docs/adr/0013-solo-no-required-review.md for why required_review_count is 0.",
      "required": ["branch", "required_contexts", "required_review_count"],
      "properties": {
        "branch": { "type": "string" },
        "required_contexts": { "type": "array", "items": { "type": "string" } },
        "required_review_count": { "type": "integer", "minimum": 0 },
        "enforce_admins": { "type": "boolean" },
        "strict": { "type": "boolean" }
      }
    },
    "ci": {
      "type": "object",
      "additionalProperties": false,
      "description": "CI path filters only. The required-checks list lives solely in branch_protection.required_contexts (single source); project-config.sh derives CI_REQUIRED_CHECKS from it.",
      "required": ["path_filters"],
      "properties": {
        "path_filters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code_globs", "docs_ignore"],
          "properties": {
            "code_globs": { "type": "array", "items": { "type": "string" } },
            "docs_ignore": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "merge_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cr_bot_logins", "override_labels"],
      "properties": {
        "cr_bot_logins": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "override_labels": { "type": "array", "items": { "type": "string" } }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "description": "Numeric line-coverage gate config (coverage.yml). See coverage-threshold-graduation.",
      "properties": {
        "_doc": { "type": "string" },
        "threshold": { "type": "integer", "minimum": 0, "maximum": 100 },
        "ramp_target": { "type": "integer", "minimum": 0, "maximum": 100 },
        "excluded": { "type": "array", "items": { "type": "string" } }
      }
    },
    "visual_validation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "_doc": { "type": "string" },
        "trigger_globs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "golden": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "artifacts_dir": { "type": "string" } }
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["discovery_mode", "supported"],
      "properties": {
        "discovery_mode": { "type": "string", "enum": ["flat-symlink", "recursive", "flat"] },
        "supported": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    },
    "environments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_tier", "tiers"],
      "properties": {
        "_doc": { "type": "string" },
        "default_tier": { "type": "string" },
        "tiers": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["expects"],
            "properties": {
              "description": { "type": "string" },
              "expects": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": ["cmake", "ninja", "git", "compiler", "link.exe", "python"]
                }
              }
            }
          }
        }
      }
    },
    "guards": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "doc_validation": { "type": "array", "items": { "type": "string" } } }
    },
    "docs": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "taxonomy_exceptions": { "type": "array", "items": { "type": "string" } } }
    },
    "subsystems": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "agents"],
        "properties": {
          "name": { "type": "string" },
          "agents": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "agents": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled_project"],
      "description": "Project agent registry + agent-prompt size budgets (agent_size_audit.py). The size_*/contract_*/sink_warn caps are delta-gated line budgets over the agentic docs; see reduce-agent-prompt-bloat Slice 0.",
      "properties": {
        "_doc": { "type": "string" },
        "enabled_project": { "type": "array", "items": { "type": "string" } },
        "size_budget_lines": { "type": "integer", "minimum": 1, "description": "Hard cap (BLOCKS) for the agent-prompt class (agents/core, agents/project)." },
        "size_warn_lines": { "type": "integer", "minimum": 1, "description": "Soft-warn line count for the agent-prompt class (advisory)." },
        "contract_budget_lines": { "type": "integer", "minimum": 1, "description": "Hard cap (BLOCKS) for AGENTS.md (the every-session contract)." },
        "contract_warn_lines": { "type": "integer", "minimum": 1, "description": "Soft-warn line count for AGENTS.md (advisory)." },
        "sink_warn_lines": { "type": "integer", "minimum": 1, "description": "Soft-warn-only line count for the sink classes (docs/agent-rules, agents/_shared/skills); never blocks." }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "description": "Human-authority charter (AI_POLICY.md) defaults.",
      "properties": {
        "_doc": { "type": "string" },
        "policy": { "type": "string" },
        "loop_mode": { "type": "string", "enum": ["in", "on"] },
        "auto_merge": { "type": "string", "enum": ["on", "off"] },
        "session_token_ceiling": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
